{
  "name": "fixpoint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An agentified appliance-repair website for the Open Agentic Web Challenge.",
  "scripts": {
    "dev": "npm run build:network && vite",
    "build": "npm run check:network && tsc -b && vite build",
    "preview": "node tooling/scripts/serve_site.mjs dist --port 8080",
    "build:network": "node tooling/scripts/build_network.mjs fixpoint.hocon --manifest ./public/agent-manifest.json --runtime ./public/runtime --out ./public/fixpoint.network.json",
    "check:network": "node tooling/scripts/build_network.mjs fixpoint.hocon --manifest ./public/agent-manifest.json --runtime ./public/runtime --out ./public/fixpoint.network.json --check",
    "check:spec": "node tooling/scripts/check_spec.mjs",
    "check:peers": "node tooling/scripts/check_peers.mjs",
    "check:partner": "node tooling/scripts/check_partner.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:actions",
    "test:unit": "vitest run",
    "test:actions": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
