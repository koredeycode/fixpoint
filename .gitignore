# === PRIVATE PLANNING — never publish ===
personal/

# === dependencies / build ===
node_modules/
dist/
dist-ssr/
.vite/
*.local

# === generated agent artifacts (rebuilt by `npm run build:network`) ===
# These ARE published to the site, so they are NOT ignored here.
# Only local build caches are ignored.
*.tsbuildinfo

# === keys / secrets (BYOK keys must never be committed) ===
.env
.env.*
!.env.example
*.pem
*.key

# === editor / OS ===
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# === logs ===
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
